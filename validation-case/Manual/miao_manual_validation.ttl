@prefix ex: <http://example.org/miao/manual-validation#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix miao: <https://w3id.org/miao#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix icd11: <http://id.who.int/icd/entity/> .
@prefix snomed: <http://snomed.info/id/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://example.org/miao/manual-validation#> .

<http://example.org/miao/manual-validation#> rdf:type owl:Ontology ;
                                              owl:imports <https://raw.githubusercontent.com/IDA-FBK/mental-health-ontology/refs/heads/main/ontology/miao.ttl> .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/identifier
dcterms:identifier rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broader
skos:broader rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#related
skos:related rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/name
foaf:name rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/title
foaf:title rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Classes
#################################################################

###  http://example.org/miao/manual-validation#Depression
ex:Depression rdf:type owl:Class ;
              rdfs:subClassOf miao:MentalIllness .


###  http://xmlns.com/foaf/0.1/Person
foaf:Person rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/miao/manual-validation#AnxietyDepressionSchema_MultiLabel
ex:AnxietyDepressionSchema_MultiLabel rdf:type owl:NamedIndividual ,
                                               miao:MentalIllnessesSchema ;
                                      miao:hasMentalIllnessCategory ex:Anxiety_ML ,
                                                                    ex:Depression_ML ,
                                                                    ex:NoMentalIllness_ML ;
                                      dcterms:created "2025-12-02"^^xsd:date ;
                                      dcterms:description "Multi-label schema enabling simultaneous classification of both anxiety and depression conditions, addressing their common comorbidity."@en ;
                                      dcterms:title "Multi-label Anxiety and Depression Schema"@en .


###  http://example.org/miao/manual-validation#Anxiety_ML
ex:Anxiety_ML rdf:type owl:NamedIndividual ,
                       miao:MentalIllnessCategory ;
              miao:isMentalIllnessCategoryOf ex:AnxietyDepressionSchema_MultiLabel ;
              dcterms:description "Anxiety symptoms detected in multi-label classification context."@en ;
              dcterms:title "Anxiety (Multi-label)"@en ;
              rdfs:label "Anxiety"@en ;
              skos:broader ex:DSM5_GAD .


###  http://example.org/miao/manual-validation#DSM5_GAD
ex:DSM5_GAD rdf:type owl:NamedIndividual ,
                     miao:MentalIllnessCategory ;
            miao:isMentalIllnessCategoryOf ex:DSM5_Schema ;
            dcterms:description "Excessive anxiety and worry about various activities or events, occurring more days than not for at least six months."@en ;
            dcterms:identifier "300.02" ;
            dcterms:title "Generalized Anxiety Disorder"@en ;
            skos:exactMatch <http://snomed.info/id/21897009> .


###  http://example.org/miao/manual-validation#DSM5_MDD
ex:DSM5_MDD rdf:type owl:NamedIndividual ,
                     miao:MentalIllnessCategory ;
            miao:isMentalIllnessCategoryOf ex:DSM5_Schema ;
            dcterms:description "A mental health disorder characterized by persistently depressed mood or loss of interest in activities, causing significant impairment in daily life."@en ;
            dcterms:identifier "296.2x-296.3x" ;
            dcterms:title "Major Depressive Disorder"@en ;
            skos:closeMatch <http://id.who.int/icd/entity/6A70> ;
            skos:exactMatch <http://snomed.info/id/370143000> .


###  http://example.org/miao/manual-validation#DSM5_PersistentDepressiveDisorder
ex:DSM5_PersistentDepressiveDisorder rdf:type owl:NamedIndividual ,
                                              miao:MentalIllnessCategory ;
                                     miao:isMentalIllnessCategoryOf ex:DSM5_Schema ;
                                     dcterms:description "A chronic form of depression with symptoms lasting at least two years in adults."@en ;
                                     dcterms:identifier "300.4" ;
                                     dcterms:title "Persistent Depressive Disorder (Dysthymia)"@en ;
                                     skos:exactMatch <http://snomed.info/id/78667006> .


###  http://example.org/miao/manual-validation#DSM5_Schema
ex:DSM5_Schema rdf:type owl:NamedIndividual ,
                        miao:MentalIllnessesSchema ;
               miao:hasMentalIllnessCategory ex:DSM5_GAD ,
                                             ex:DSM5_MDD ,
                                             ex:DSM5_PersistentDepressiveDisorder ;
               dcterms:created "2013"^^xsd:gYear ;
               dcterms:description "The Diagnostic and Statistical Manual of Mental Disorders, Fifth Edition (DSM-5), is the authoritative guide to the diagnosis of mental disorders used by healthcare professionals in the United States and much of the world."@en ;
               dcterms:publisher "American Psychiatric Association" ;
               dcterms:title "DSM-5: Diagnostic and Statistical Manual of Mental Disorders, Fifth Edition"@en .


###  http://example.org/miao/manual-validation#DepressionSeveritySchema_Research
ex:DepressionSeveritySchema_Research rdf:type owl:NamedIndividual ,
                                              miao:MentalIllnessesSchema ;
                                     miao:hasMentalIllnessCategory ex:MildDepression ,
                                                                   ex:MinimalDepression ,
                                                                   ex:ModerateDepression ,
                                                                   ex:SevereDepression ;
                                     dcterms:created "2025-12-02"^^xsd:date ;
                                     dcterms:description "Ordinal taxonomy of depression severity (Minimal, Mild, Moderate, Severe) used in social media corpora and text-based computational research on depression detection. Based on PHQ-9 severity thresholds."@en ;
                                     dcterms:source "Kroenke K, Spitzer RL, Williams JB. The PHQ-9: validity of a brief depression severity measure. J Gen Intern Med. 2001;16(9):606-13." ;
                                     dcterms:title "Research schema for depression severity in text"@en .


###  http://example.org/miao/manual-validation#Depression_ML
ex:Depression_ML rdf:type owl:NamedIndividual ,
                          miao:MentalIllnessCategory ;
                 miao:isMentalIllnessCategoryOf ex:AnxietyDepressionSchema_MultiLabel ;
                 dcterms:description "Depressive symptoms detected in multi-label classification context."@en ;
                 dcterms:title "Depression (Multi-label)"@en ;
                 rdfs:label "Depression"@en ;
                 skos:broader ex:DSM5_MDD .


###  http://example.org/miao/manual-validation#DrLauraMartin
ex:DrLauraMartin rdf:type owl:NamedIndividual ,
                          prov:Agent ,
                          prov:Person ,
                          foaf:Person ;
                 dcterms:identifier "ESP-PSY-2018-45892" ;
                 rdfs:comment "Licensed clinical psychologist specialized in mood disorders"@en ;
                 foaf:name "Dr. Laura Martin" ;
                 foaf:title "PhD" .


###  http://example.org/miao/manual-validation#ICD11_DepressionSchema
ex:ICD11_DepressionSchema rdf:type owl:NamedIndividual ,
                                   miao:MentalIllnessesSchema ;
                          miao:hasMentalIllnessCategory ex:ICD11_RecurrentDepression ,
                                                        ex:ICD11_SingleEpisodeDepression ;
                          dcterms:created "2025-12-02"^^xsd:date ;
                          dcterms:description "Depression classification aligned with ICD-11 categories for interoperability with international health records."@en ;
                          dcterms:publisher "World Health Organization" ;
                          dcterms:title "ICD-11 Aligned Depression Schema"@en .


###  http://example.org/miao/manual-validation#ICD11_RecurrentDepression
ex:ICD11_RecurrentDepression rdf:type owl:NamedIndividual ,
                                      miao:MentalIllnessCategory ;
                             miao:isMentalIllnessCategoryOf ex:ICD11_DepressionSchema ;
                             dcterms:description "A depressive disorder characterized by a history of at least two depressive episodes."@en ;
                             dcterms:title "Recurrent Depressive Disorder"@en ;
                             rdfs:label "Recurrent Depressive Disorder"@en ;
                             skos:related <http://snomed.info/id/191616009> .


###  http://example.org/miao/manual-validation#ICD11_SingleEpisodeDepression
ex:ICD11_SingleEpisodeDepression rdf:type owl:NamedIndividual ,
                                          miao:MentalIllnessCategory ;
                                 miao:isMentalIllnessCategoryOf ex:ICD11_DepressionSchema ;
                                 dcterms:description "A depressive disorder characterized by a single episode without history of prior episodes."@en ;
                                 dcterms:title "Single Episode Depressive Disorder"@en ;
                                 rdfs:label "Single Episode Depressive Disorder"@en ;
                                 skos:closeMatch ex:DSM5_MDD .


###  http://example.org/miao/manual-validation#ManualDetection_P00010_S12
ex:ManualDetection_P00010_S12 rdf:type owl:NamedIndividual ,
                                       miao:ManualMentalIllnessesDetection ;
                              prov:generated ex:MentalIllnessesSet_P00010 ;
                              prov:wasAssociatedWith ex:DrLauraMartin ;
                              miao:hasInputData ex:PatientQuestionnaire_P00010 ,
                                                ex:TherapySessionNotes_P00010 ;
                              miao:usedMentalIllnessesSchema ex:DSM5_Schema ;
                              dcterms:created "2025-11-28T12:00:00Z"^^xsd:dateTime ;
                              rdfs:label "Clinical assessment of patient P00010"@en .


###  http://example.org/miao/manual-validation#MentalIllness_MDD_P00010
ex:MentalIllness_MDD_P00010 rdf:type owl:NamedIndividual ,
                                     ex:Depression ;
                            miao:belongsToMentalIllnessesSet ex:MentalIllnessesSet_P00010 ;
                            miao:referredToMentalIllnessCategory ex:DSM5_MDD ;
                            miao:hasMentalIllnessLevel "Moderate to Severe" ;
                            miao:refersToSample "SESSION-NOTES-P00010-S12" ;
                            rdfs:comment "Diagnosis based on clinical observation of DSM-5 criteria including depressed mood, anhedonia, sleep disturbances, fatigue, concentration difficulties, and passive suicidal ideation"@en ;
                            rdfs:label "Major Depressive Disorder diagnosis for patient P00010"@en .


###  http://example.org/miao/manual-validation#MentalIllnessesSet_P00010
ex:MentalIllnessesSet_P00010 rdf:type owl:NamedIndividual ,
                                      prov:Entity ,
                                      miao:MentalIllnessesSet ;
                             prov:wasAttributedTo ex:DrLauraMartin ;
                             prov:wasGeneratedBy ex:ManualDetection_P00010_S12 ;
                             miao:hasMentalIllness ex:MentalIllness_MDD_P00010 ;
                             dcterms:created "2025-11-28T12:00:00Z"^^xsd:dateTime .


###  http://example.org/miao/manual-validation#MildDepression
ex:MildDepression rdf:type owl:NamedIndividual ,
                           miao:MentalIllnessCategory ;
                  miao:isMentalIllnessCategoryOf ex:DepressionSeveritySchema_Research ;
                  dcterms:description "Mild depressive symptoms. PHQ-9 score range: 5-9. May warrant watchful waiting and repeated assessment."@en ;
                  dcterms:identifier 1 ;
                  dcterms:title "Mild depression"@en ;
                  rdfs:label "Mild Depression"@en ;
                  skos:related <http://snomed.info/id/310495003> .


###  http://example.org/miao/manual-validation#MinimalDepression
ex:MinimalDepression rdf:type owl:NamedIndividual ,
                              miao:MentalIllnessCategory ;
                     miao:isMentalIllnessCategoryOf ex:DepressionSeveritySchema_Research ;
                     dcterms:description "Minimal or no depressive symptoms. PHQ-9 score range: 0-4. Indicates little to no clinical significance."@en ;
                     dcterms:identifier 0 ;
                     dcterms:title "Minimal depression"@en ;
                     rdfs:label "Minimal Depression"@en .


###  http://example.org/miao/manual-validation#ModerateDepression
ex:ModerateDepression rdf:type owl:NamedIndividual ,
                               miao:MentalIllnessCategory ;
                      miao:isMentalIllnessCategoryOf ex:DepressionSeveritySchema_Research ;
                      dcterms:description "Moderate depressive symptoms. PHQ-9 score range: 10-14. Warrants treatment plan, considering counseling, follow-up, and/or pharmacotherapy."@en ;
                      dcterms:identifier 2 ;
                      dcterms:title "Moderate depression"@en ;
                      rdfs:label "Moderate Depression"@en ;
                      skos:related <http://snomed.info/id/310496002> .


###  http://example.org/miao/manual-validation#NoMentalIllness_ML
ex:NoMentalIllness_ML rdf:type owl:NamedIndividual ,
                               miao:MentalIllnessCategory ;
                      miao:isMentalIllnessCategoryOf ex:AnxietyDepressionSchema_MultiLabel ;
                      dcterms:description "No mental illness indicators detected in the analyzed data."@en ;
                      dcterms:title "No Mental Illness Detected"@en ;
                      rdfs:label "No Mental Illness"@en .


###  http://example.org/miao/manual-validation#PatientQuestionnaire_P00010
ex:PatientQuestionnaire_P00010 rdf:type owl:NamedIndividual ,
                                        mls:Dataset ;
                               dcterms:created "2025-11-28T10:30:00Z"^^xsd:dateTime ;
                               dcterms:identifier "PHQ9-P00010-S12" ;
                               dcterms:title "Patient Health Questionnaire-9 (PHQ-9)"@en ;
                               rdfs:comment "PHQ-9 score of 17 indicates moderately severe depression"@en .


###  http://example.org/miao/manual-validation#Patient_P00010
ex:Patient_P00010 rdf:type owl:NamedIndividual ,
                           prov:Agent ,
                           prov:Person ,
                           foaf:Person ;
                  dcterms:identifier "P00010" ;
                  rdfs:comment "Anonymized patient identifier"@en .


###  http://example.org/miao/manual-validation#SevereDepression
ex:SevereDepression rdf:type owl:NamedIndividual ,
                             miao:MentalIllnessCategory ;
                    miao:isMentalIllnessCategoryOf ex:DepressionSeveritySchema_Research ;
                    dcterms:description "Severe depressive symptoms. PHQ-9 score range: 15-27 (includes moderately severe 15-19 and severe 20-27). Warrants active treatment with pharmacotherapy and/or psychotherapy."@en ;
                    dcterms:identifier 3 ;
                    dcterms:title "Severe depression"@en ;
                    rdfs:label "Severe Depression"@en ;
                    skos:related <http://snomed.info/id/310497006> .


###  http://example.org/miao/manual-validation#StressNegative
ex:StressNegative rdf:type owl:NamedIndividual ,
                           miao:MentalIllnessCategory ;
                  miao:isMentalIllnessCategoryOf ex:StressSchema_Binary ;
                  dcterms:description "No psychological stress indicators detected. Subject appears to be in a normal psychological state without significant stress markers."@en ;
                  dcterms:identifier 0 ;
                  dcterms:title "No Stress"@en ;
                  rdfs:label "No Stress Detected"@en .


###  http://example.org/miao/manual-validation#StressPositive
ex:StressPositive rdf:type owl:NamedIndividual ,
                           miao:MentalIllnessCategory ;
                  miao:isMentalIllnessCategoryOf ex:StressSchema_Binary ;
                  dcterms:description "Psychological stress indicators detected through linguistic markers, physiological signals, or behavioral patterns."@en ;
                  dcterms:identifier 1 ;
                  dcterms:title "Stress"@en ;
                  rdfs:label "Stress Detected"@en ;
                  skos:related <http://snomed.info/id/262188008> .


###  http://example.org/miao/manual-validation#StressSchema_Binary
ex:StressSchema_Binary rdf:type owl:NamedIndividual ,
                                miao:MentalIllnessesSchema ;
                       miao:hasMentalIllnessCategory ex:StressNegative ,
                                                     ex:StressPositive ;
                       dcterms:created "2025-12-02"^^xsd:date ;
                       dcterms:description "Binary schema for computational stress detection from text and multimodal signals. Used in social media analysis and real-time monitoring applications."@en ;
                       dcterms:source "Turcan E, McKeown K. Dreaddit: A Reddit Dataset for Stress Analysis in Social Media. LOUHI 2019." ;
                       dcterms:title "Binary Stress Classification Schema"@en .


###  http://example.org/miao/manual-validation#TherapySessionNotes_P00010
ex:TherapySessionNotes_P00010 rdf:type owl:NamedIndividual ,
                                       mls:Dataset ;
                              prov:wasAttributedTo ex:DrLauraMartin ;
                              dcterms:created "2025-11-28T11:45:00Z"^^xsd:dateTime ;
                              dcterms:identifier "SESSION-NOTES-P00010-S12" ;
                              dcterms:title "Clinical Session Notes - Session 12"@en ;
                              rdfs:comment "Clinical notes documenting depressive symptoms including low mood, anhedonia, sleep disturbances, and passive suicidal ideation"@en .


