@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix miao: <https://w3id.org/miao#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix miaoval: <http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#> .
@base <http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#> .

<http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#> rdf:type owl:Ontology ;
                                                                       owl:imports <https://raw.githubusercontent.com/IDA-FBK/mental-health-ontology/refs/heads/main/ontology/miao.ttl> .

#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#Classification
miaoval:Classification rdf:type owl:Class ;
                       rdfs:subClassOf mls:Algorithm .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#BinaryClassificationTask
miaoval:BinaryClassificationTask rdf:type owl:NamedIndividual ,
                                          mls:Task ;
                                 mls:definedOn miaoval:CNNWord2vec ,
                                               miaoval:RedditPosts ,
                                               miaoval:XGBoostTF-IDFvec .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAlgoritm
miaoval:CNNAlgoritm rdf:type owl:NamedIndividual ,
                             miaoval:Classification .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxiety3
miaoval:CNNAnxiety3 rdf:type owl:NamedIndividual ,
                             miao:MentalIllness ;
                    miao:belongsToMentalIllnessesSet miaoval:CNNAnxietySet ;
                    miao:referredToMentalIllnessCategory miaoval:B00-GeneralisedAnxietyDisorder ;
                    miao:hasMentalIllnessDetectionConfidence 0.95 ;
                    miao:refersToSample "post3" .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyAccuracy
miaoval:CNNAnxietyAccuracy rdf:type owl:NamedIndividual ,
                                    mls:EvaluationMeasure .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyAccuracyEval
miaoval:CNNAnxietyAccuracyEval rdf:type owl:NamedIndividual ,
                                        mls:ModelEvaluation ;
                               mls:specifiedBy miaoval:CNNAnxietyAccuracy ;
                               mls:hasValue "77.81"^^xsd:float .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyDetection
miaoval:CNNAnxietyDetection rdf:type owl:NamedIndividual ,
                                     miao:AutomaticMentalIllnessesDetection ;
                            mls:achieves miaoval:BinaryClassificationTask ;
                            mls:executes miaoval:CNNAnxietyImplementation ;
                            mls:hasInput miaoval:CNNAnxietyEpochsSetting ,
                                         miaoval:CNNAnxietyLearningRateSetting ;
                            mls:hasOutput miaoval:CNNAnxietyAccuracyEval ,
                                          miaoval:CNNAnxietyF1Eval ,
                                          miaoval:CNNAnxietyModel ,
                                          miaoval:CNNAnxietyPrecisionEval ,
                                          miaoval:CNNAnxietyRecallEval ;
                            mls:realizes miaoval:CNNAlgoritm ;
                            <http://www.w3.org/ns/prov#generated> miaoval:CNNAnxietySet ;
                            miao:hasInputData miaoval:CNNWord2vec ,
                                              miaoval:RedditPosts ;
                            miao:usedMentalIllnessesSchema miaoval:ICD-11 .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyEpochs
miaoval:CNNAnxietyEpochs rdf:type owl:NamedIndividual ,
                                  mls:HyperParameter ;
                         mls:hasValue "50.0"^^xsd:float .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyEpochsSetting
miaoval:CNNAnxietyEpochsSetting rdf:type owl:NamedIndividual ,
                                         mls:HyperParameterSetting ;
                                mls:specifiedBy miaoval:CNNAnxietyEpochs .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyEvalSpec
miaoval:CNNAnxietyEvalSpec rdf:type owl:NamedIndividual ,
                                    mls:EvaluationSpecification ;
                           mls:defines miaoval:BinaryClassificationTask ;
                           mls:hasPart miaoval:CNNAnxietyAccuracy ,
                                       miaoval:CNNAnxietyF1 ,
                                       miaoval:CNNAnxietyPrecision ,
                                       miaoval:CNNAnxietyRecall ,
                                       miaoval:Hold-out .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyF1
miaoval:CNNAnxietyF1 rdf:type owl:NamedIndividual ,
                              mls:EvaluationMeasure .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyF1Eval
miaoval:CNNAnxietyF1Eval rdf:type owl:NamedIndividual ,
                                  mls:ModelEvaluation ;
                         mls:specifiedBy miaoval:CNNAnxietyF1 ;
                         mls:hasValue "56.25"^^xsd:float .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyImplementation
miaoval:CNNAnxietyImplementation rdf:type owl:NamedIndividual ,
                                          mls:Implementation ;
                                 mls:hasPart miaoval:PyTorch .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyLearningRate
miaoval:CNNAnxietyLearningRate rdf:type owl:NamedIndividual ,
                                        mls:HyperParameter ;
                               mls:hasValue "0.001"^^xsd:float .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyLearningRateSetting
miaoval:CNNAnxietyLearningRateSetting rdf:type owl:NamedIndividual ,
                                               mls:HyperParameterSetting ;
                                      mls:specifiedBy miaoval:CNNAnxietyLearningRate .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyModel
miaoval:CNNAnxietyModel rdf:type owl:NamedIndividual ,
                                 mls:Model .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyPrecision
miaoval:CNNAnxietyPrecision rdf:type owl:NamedIndividual ,
                                     mls:EvaluationMeasure .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyPrecisionEval
miaoval:CNNAnxietyPrecisionEval rdf:type owl:NamedIndividual ,
                                         mls:ModelEvaluation ;
                                mls:specifiedBy miaoval:CNNAnxietyPrecision ;
                                mls:hasValue "87.54"^^xsd:float .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyRecall
miaoval:CNNAnxietyRecall rdf:type owl:NamedIndividual ,
                                  mls:EvaluationMeasure .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietyRecallEval
miaoval:CNNAnxietyRecallEval rdf:type owl:NamedIndividual ,
                                      mls:ModelEvaluation ;
                             mls:specifiedBy miaoval:CNNAnxietyRecall ;
                             mls:hasValue "41.44"^^xsd:float .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAnxietySet
miaoval:CNNAnxietySet rdf:type owl:NamedIndividual ,
                               miao:MentalIllnessesSet ;
                      <http://www.w3.org/ns/prov#wasGeneratedBy> miaoval:CNNAnxietyDetection ;
                      miao:hasMentalIllness miaoval:CNNAnxiety3 .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAutism1
miaoval:CNNAutism1 rdf:type owl:NamedIndividual ,
                            miao:MentalIllness ;
                   miao:belongsToMentalIllnessesSet miaoval:CNNAutismSet ;
                   miao:referredToMentalIllnessCategory miaoval:A02-AutismSpectrumDisorder ;
                   miao:hasMentalIllnessDetectionConfidence 0.9 ;
                   miao:refersToSample "post1" .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAutismAccuracy
miaoval:CNNAutismAccuracy rdf:type owl:NamedIndividual ,
                                   mls:EvaluationMeasure .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAutismAccuracyEval
miaoval:CNNAutismAccuracyEval rdf:type owl:NamedIndividual ,
                                       mls:ModelEvaluation ;
                              mls:specifiedBy miaoval:CNNAutismAccuracy ;
                              mls:hasValue "96.96"^^xsd:float .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAutismDetection
miaoval:CNNAutismDetection rdf:type owl:NamedIndividual ,
                                    miao:AutomaticMentalIllnessesDetection ;
                           mls:achieves miaoval:BinaryClassificationTask ;
                           mls:executes miaoval:CNNAutismImplementation ;
                           mls:hasInput miaoval:CNNAutismEpochsSetting ,
                                        miaoval:CNNAutismLearningRateSetting ;
                           mls:hasOutput miaoval:CNNAutismAccuracyEval ,
                                         miaoval:CNNAutismF1Eval ,
                                         miaoval:CNNAutismModel ,
                                         miaoval:CNNAutismPrecisionEval ,
                                         miaoval:CNNAutismRecallEval ;
                           mls:realizes miaoval:CNNAlgoritm ;
                           <http://www.w3.org/ns/prov#generated> miaoval:CNNAutismSet ;
                           miao:hasInputData miaoval:CNNWord2vec ,
                                             miaoval:RedditPosts ;
                           miao:usedMentalIllnessesSchema miaoval:ICD-11 .


###  http://www.semanticweb.org/sanar/ontologies/2026/0/miao-validation#CNNAutismEpochs
miaoval:CNNAutismEpochs rdf:type owl:NamedIndividual ,
